<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content={
        assigns[:description] ||
          "Sam Youatt's notes on software, side projects, and learning by building."
      }
    />
    <.live_title default="Sam Youatt" suffix=" · Sam Youatt">
      {assigns[:page_title]}
    </.live_title>
    <meta :if={assigns[:preview_image]} property="og:image" content={@preview_image} />
    <meta :if={assigns[:preview_image]} property="og:image:width" content="1200" />
    <meta :if={assigns[:preview_image]} property="og:image:height" content="630" />
    <meta :if={assigns[:preview_image]} name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/x-icon" href={~p"/favicon.ico"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link
      rel="preload"
      href={~p"/fonts/MADEDillan.woff2"}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      :for={font <- assigns[:preload_fonts] || []}
      rel="preload"
      href={font}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-zinc-50 text-zinc-700 dark:bg-zinc-950 dark:text-zinc-200">
    {@inner_content}
  </body>
</html>
