<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>404 - Not 'ere · Sam Youatt</title>
    <link rel="icon" type="image/x-icon" href={~p"/favicon.ico"} />
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link
      rel="preload"
      href={~p"/fonts/MADEDillan.woff2"}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
  </head>
  <body class="bg-stone-50 text-stone-800 dark:bg-stone-800 dark:text-stone-200">
    <main class="flex min-h-screen items-center justify-center px-4 text-center">
      <h1
        id="not-found-title"
        class="flex flex-col items-center gap-3 font-hero text-5xl leading-none sm:text-6xl"
      >
        <%!-- Match the visible glyph widths in MADE Dillan, rather than stretching the font. --%>
        <span class="translate-x-[0.006em] text-[2.02em] text-red-400">404</span>
        <span>Not 'ere</span>
      </h1>
    </main>
  </body>
</html>
