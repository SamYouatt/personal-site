<Layouts.app flash={@flash}>
  <section id="photos" aria-labelledby="photos-title" class="px-4 pt-16 pb-12 sm:px-8 sm:pt-24">
    <header class="mx-auto mb-8 max-w-[97.5ch]">
      <h1
        id="photos-title"
        class="photo-title text-center text-xl leading-tight font-light text-black sm:text-[1.75rem] dark:text-white"
      >
        North Coast 500
      </h1>
      <div
        id="photo-title-rule"
        class="photo-title-rule mt-2 text-black sm:-mt-3 dark:text-white"
        aria-hidden="true"
      >
        <span class="photo-title-castle"></span>
      </div>
    </header>

    <.photo_gallery
      :if={@photo_base_url}
      id="photo-gallery"
      photos={@nc500_photos}
      base_url={@photo_base_url}
      eager_first
    />

    <p
      :if={!@photo_base_url}
      id="photos-unavailable"
      class="mx-auto max-w-[65ch] py-12 text-zinc-500 dark:text-zinc-400"
    >
      Photographs will be available here soon.
    </p>
  </section>

  <section
    id="san-francisco"
    aria-labelledby="san-francisco-title"
    class="px-4 pt-8 pb-12 sm:px-8 sm:pt-12"
  >
    <header class="mx-auto mb-8 max-w-[97.5ch]">
      <h2
        id="san-francisco-title"
        class="photo-title text-center text-xl leading-tight font-light text-black sm:text-[1.75rem] dark:text-white"
      >
        San Francisco
      </h2>
      <div
        id="san-francisco-title-rule"
        class="photo-title-rule photo-title-rule-left mt-2 text-black sm:-mt-3 dark:text-white"
        aria-hidden="true"
      >
        <span class="photo-title-bridge"></span>
      </div>
    </header>

    <.photo_gallery
      :if={@photo_base_url}
      id="sf-photo-gallery"
      photos={@sf_photos}
      base_url={@photo_base_url}
    />
  </section>

  <dialog
    :for={{id, photo} <- @photos}
    :if={@photo_base_url}
    id={"photo-lightbox-#{id}"}
    aria-label={photo_alt(id)}
    class="photo-lightbox fixed inset-0 m-auto h-dvh max-h-none w-screen max-w-none items-center justify-center bg-zinc-950 text-white open:flex backdrop:bg-zinc-950"
  >
    <form method="dialog" class="absolute top-4 right-4 z-10">
      <button
        id={"photo-close-#{id}"}
        type="submit"
        autofocus
        aria-label="Close photograph"
        class="flex size-11 cursor-pointer items-center justify-center rounded-full bg-zinc-900/90 transition-colors hover:bg-zinc-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        <.icon name="hero-x-mark" class="size-6" />
      </button>
    </form>
    <%!-- Mat: percentages of image width, in CSS top/right/bottom/left order. Omit for none. --%>
    <.photo_print
      id={"photo-print-#{id}"}
      photo={photo}
      base_url={@photo_base_url}
      mat={photo_mat(id, photo)}
      alt={photo_alt(id)}
    />
  </dialog>
</Layouts.app>
